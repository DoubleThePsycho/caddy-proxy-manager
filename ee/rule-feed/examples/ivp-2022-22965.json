{
  "id": "ivp-2022-22965",
  "example": true,
  "cves": [
    "CVE-2022-22965"
  ],
  "title": "Spring Framework data binding to the class loader (Spring4Shell)",
  "summary": "Spring MVC and Spring WebFlux bind request parameters to the properties of an object. On JDK 9 and later the binding can reach the class loader through class.module.classLoader, and on Apache Tomcat (WAR deployment) a request can rewrite the access log settings to write a JSP web shell. The rule matches parameter and cookie names that bind through class.module.classLoader.",
  "affected": [
    {
      "product": "Spring Framework (spring-webmvc, spring-webflux)",
      "versions": "5.3.0 to 5.3.17, 5.2.0 to 5.2.19 and older unsupported versions",
      "fixed": "5.3.18, 5.2.20"
    }
  ],
  "severity": "critical",
  "publishedAt": "2022-03-31T00:00:00Z",
  "updatedAt": "2022-04-01T00:00:00Z",
  "references": [
    "https://nvd.nist.gov/vuln/detail/CVE-2022-22965",
    "https://spring.io/security/cve-2022-22965"
  ],
  "defaultMode": "block",
  "rules": [
    "SecRule ARGS_NAMES|REQUEST_COOKIES_NAMES \"@rx (?i)(?:^|\\.)class\\.module\\.classloader(?:\\.|\\[)\" \"id:1800000301,phase:2,t:none\""
  ],
  "samples": {
    "positive": [
      {
        "method": "GET",
        "path": "/greeting?class.module.classLoader.resources.context.parent.pipeline.first.pattern=test"
      },
      {
        "method": "POST",
        "path": "/greeting",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "class.module.classLoader.resources.context.parent.pipeline.first.suffix=.jsp"
      }
    ],
    "negative": [
      {
        "method": "GET",
        "path": "/greeting?name=class.module.classLoader"
      },
      {
        "method": "GET",
        "path": "/greeting?classification.module=public"
      }
    ]
  }
}
