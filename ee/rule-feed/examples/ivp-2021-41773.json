{
  "id": "ivp-2021-41773",
  "example": true,
  "cves": [
    "CVE-2021-41773"
  ],
  "title": "Apache HTTP Server 2.4.49 path traversal with encoded dots",
  "summary": "Apache HTTP Server 2.4.49 normalises request paths before decoding them, so a path segment of two dots with one of them percent-encoded (.%2e) is not recognised as a parent directory. Outside directories protected by Require all denied, such requests read files outside the document root, and with mod_cgi enabled they can run programs. The rule matches path segments of two dots where at least one is encoded, once or twice (%2e, %252e), in the request URI as sent.",
  "affected": [
    {
      "product": "Apache HTTP Server",
      "versions": "2.4.49",
      "fixed": "2.4.51 (2.4.50 fixed it incompletely, see CVE-2021-42013)"
    }
  ],
  "severity": "high",
  "publishedAt": "2021-10-05T00:00:00Z",
  "updatedAt": "2021-10-05T00:00:00Z",
  "references": [
    "https://nvd.nist.gov/vuln/detail/CVE-2021-41773",
    "https://httpd.apache.org/security/vulnerabilities_24.html"
  ],
  "defaultMode": "block",
  "rules": [
    "SecRule REQUEST_URI_RAW \"@rx (?i)(?:^|/|%2f)(?:\\.(?:%2e|%252e)|(?:%2e|%252e)(?:\\.|%2e|%252e))(?:/|%2f|\\?|$)\" \"id:1800000201,phase:1,t:none\""
  ],
  "samples": {
    "positive": [
      {
        "method": "GET",
        "path": "/cgi-bin/.%2e/.%2e/.%2e/.%2e/bin/sh"
      },
      {
        "method": "GET",
        "path": "/icons/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd"
      },
      {
        "method": "GET",
        "path": "/icons/%252e%252e/%252e%252e/etc/passwd"
      }
    ],
    "negative": [
      {
        "method": "GET",
        "path": "/icons/apache_pb.gif"
      },
      {
        "method": "GET",
        "path": "/docs/v2.4.49/release.notes.html"
      },
      {
        "method": "GET",
        "path": "/files/report%2edraft.txt"
      }
    ]
  }
}
